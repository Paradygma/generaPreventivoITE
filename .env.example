# Notion internal integration token (Settings -> Connections -> Develop or manage integrations)
NOTION_TOKEN=secret_xxx

# ID del data source "ODA - ITE" (collection UUID, senza dashes o con dashes va bene)
NOTION_ODA_DATA_SOURCE_ID=7be6abc8-a4de-4d92-bb86-45744d0b6409

# Contenuto JSON del service account Google Cloud (Drive + Docs API abilitate),
# incollato come stringa unica (JSON.stringify del file .json scaricato)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ID del Google Doc template (dalla URL: /document/d/<ID>/edit)
TEMPLATE_DOC_ID=1kJuzTrlpivHb84I7RRnDz2tmkRJCICTCAYVnuspnNj0

# ID della cartella Drive dove salvare i preventivi generati (personale ora, cliente in futuro)
DRIVE_OUTPUT_FOLDER_ID=

# Token condiviso opzionale per validare che la richiesta arrivi davvero da Notion
WEBHOOK_SHARED_SECRET=
